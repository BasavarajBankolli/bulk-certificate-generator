# Copy this file to .env and adjust the values. Never commit .env.

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=certificates
POSTGRES_PASSWORD=change-me
POSTGRES_DB=certificates

# --- Application ---
# Used when running the API/worker directly on your machine.
# docker-compose builds its own DATABASE_URL / REDIS_URL pointing at the containers.
DATABASE_URL=postgresql+psycopg://certificates:change-me@localhost:5432/certificates
REDIS_URL=redis://localhost:6379/0

# Directory where generated PDFs are stored (shared by API and worker).
STORAGE_DIR=storage

# Maximum number of recipients accepted in a single job.
MAX_BATCH_SIZE=1000

LOG_LEVEL=INFO
